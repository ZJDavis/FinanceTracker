<Window x:Class="FinanceTracker.Wpf.CsvImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review CSV Import" Height="620" Width="1050"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Width="90" Margin="0,0,8,0" />
            <Button Content="Import selected rows" IsDefault="True" Width="165" Click="ImportSelectedRows_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Review each row before it is added to the active database." FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="PreviewSummary" Margin="0,5,0,0" Foreground="DimGray" />
            <TextBlock Text="Possible duplicates are unchecked by default. Invalid rows cannot be selected." Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                  ItemsSource="{Binding}" SelectionMode="Extended" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Import" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsValid}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="CSV row" Binding="{Binding RowNumber}" Width="65" IsReadOnly="True" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125" IsReadOnly="True" />
                <DataGridTextColumn Header="Date" Binding="{Binding Transaction.Date}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="150" IsReadOnly="True" />
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="150" IsReadOnly="True" />
                <DataGridTextColumn Header="Payee" Binding="{Binding Transaction.Payee}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Transaction.Amount}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
